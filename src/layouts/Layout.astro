---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import BackgroundAudio from '../components/BackgroundAudio.astro';
import BrainScene from '../components/BrainScene.astro';
import EnterGate from '../components/EnterGate.astro';

interface Props {
  title: string;
  active: string;
}

const { title, active } = Astro.props;

const SITE_TITLE = 'Daniel Hong';

// Nav items in visual groups — spacing between groups is larger than
// within one (see .dir-group in global.css).
const DIRECTORY_GROUPS = [
  [
    { key: 'projects', label: 'Projects', href: '/projects' },
    { key: 'music', label: 'Music', href: '/music' },
    { key: 'renders', label: 'Renders', href: '/renders' },
  ],
  [
    { key: 'about', label: 'About', href: '/about' },
    { key: 'contact', label: 'Contact', href: '/contact' },
  ],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{active === 'home' ? SITE_TITLE : `${title} — ${SITE_TITLE}`}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- The fonts every page renders immediately (nav/headers + body copy)
         — preloaded so the browser fetches them in parallel with the CSS
         that references them, instead of discovering the need only after
         parsing global.css, which is what font-display: swap alone leaves
         on the table (a visible flash from fallback to webfont). -->
    <link rel="preload" href="/fonts/SpaceMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/SpaceMono-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/CourierPrime-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <ClientRouter />
  </head>
  <body data-page={active}>
    <BrainScene />
    <EnterGate />

    <div class="shell">
      <aside class="directory">
        <a class="site-title" href="/" aria-current={active === 'home' ? 'page' : undefined}>{SITE_TITLE}</a>
        <nav>
          {DIRECTORY_GROUPS.map((group) => (
            <div class="dir-group">
              {group.map((section) => (
                <div class="dir-section">
                  <a
                    class="dir-heading"
                    href={section.href}
                    aria-current={active === section.key ? 'page' : undefined}
                  >
                    {section.label}
                  </a>
                </div>
              ))}
            </div>
          ))}
        </nav>
      </aside>

      <div class="header-gap" aria-hidden="true"></div>

      <main class="content">
        <slot />
      </main>
    </div>

    <BackgroundAudio />
  </body>
</html>
