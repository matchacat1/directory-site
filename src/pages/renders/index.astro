---
import Layout from '../../layouts/Layout.astro';
import { visuals } from '../../data/visuals';

const items = visuals.map((v) => ({ href: `/renders/${v.slug}`, title: v.title, body: v.body, image: v.image }));
---

<Layout title="Renders" active="renders">
  <h1>Renders</h1>

  {items.length > 0 ? (
    <div class="project-grid">
      {items.map((p) => (
        <div class="project-card">
          <a class="project-image" href={p.href} aria-label={p.title}>
            <img src={p.image} alt="" loading="lazy" />
          </a>
        </div>
      ))}
    </div>
  ) : (
    <p class="muted">More coming soon.</p>
  )}
</Layout>
