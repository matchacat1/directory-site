---
import Layout from '../../layouts/Layout.astro';
import { musicTracks } from '../../data/music-tracks';
import TrackMixer from '../../components/TrackMixer.astro';
import TrackSocialLinks from '../../components/TrackSocialLinks.astro';

const SLUG = 'etona';
const idx = musicTracks.findIndex((t) => t.slug === SLUG);
const track = musicTracks[idx];
const prev = musicTracks[(idx - 1 + musicTracks.length) % musicTracks.length];
const next = musicTracks[(idx + 1) % musicTracks.length];
---

<Layout title={track.title} active="music">
  <div class="track-backdrop" style={`background-image: url(${track.image})`} aria-hidden="true"></div>

  <div class="track-title-block">
    <h1>{track.title}</h1>

    <p class="track-flavor">{track.body}</p>
  </div>

  <TrackMixer song="etona" />

  <TrackSocialLinks song="etona" />

  <nav class="track-nav" aria-label="Other music projects">
    <a class="track-nav-link track-nav-prev" href={`/music/${prev.slug}`}>
      <span class="track-nav-preview" style={`background-image: url(${prev.image})`} aria-hidden="true"></span>
      ← {prev.title}
    </a>
    <a class="track-nav-link track-nav-next" href={`/music/${next.slug}`}>
      <span class="track-nav-preview" style={`background-image: url(${next.image})`} aria-hidden="true"></span>
      {next.title} →
    </a>
  </nav>

  <a class="back-link" href="/music">← back to Music</a>
</Layout>
