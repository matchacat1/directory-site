---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact" active="contact">
  <h1>Contact</h1>

  <p class="contact-line">
    <svg class="contact-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="1.5"></rect>
      <path d="M3.5 6.5l8.5 7 8.5-7"></path>
    </svg>
    <a href="mailto:heydanielhong@gmail.com">heydanielhong@gmail.com</a>
  </p>
</Layout>

<style>
  .contact-line {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .contact-icon {
    flex: 0 0 auto;
    color: var(--ink-soft);
  }
</style>
