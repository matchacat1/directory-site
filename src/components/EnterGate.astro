---
// A single click-through gate shown on every hard page load — but only
// the first time a given browser ever sees this site (see VISITED_KEY in
// the script below). Its purpose is to guarantee a real user gesture
// happens at the exact moment the site is revealed, so BackgroundAudio's
// autoplay-muted-until-gesture unmute (see onFirstGesture there) fires
// immediately instead of waiting on some later incidental interaction. A
// returning visitor has already granted that once, so re-showing it on
// every visit would just be friction with no benefit.
---

<div id="enter-gate" class="enter-gate" transition:persist="enter-gate">
  <button id="enter-gate-btn" class="enter-gate-btn" type="button">Hello</button>
</div>

<style>
  .enter-gate {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(255, 255, 255, 0.55);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    cursor: pointer;
    transition: opacity 0.5s ease;
  }

  .enter-gate.is-visible {
    opacity: 1;
  }

  .enter-gate.is-hiding {
    opacity: 0;
    pointer-events: none;
  }

  .enter-gate-btn {
    font-family: var(--font-mono);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--ink);
    background: transparent;
    border: none;
    padding: 12px 34px;
    cursor: pointer;
  }

  .enter-gate-btn:hover,
  .enter-gate-btn:focus-visible {
    color: var(--accent);
  }
</style>

<script>
  if (!(window as any).__enterGateInit) {
    (window as any).__enterGateInit = true;

    const gate = document.getElementById('enter-gate') as HTMLElement;
    const FADE_MS = 500;
    const VISITED_KEY = 'site-visited';

    let alreadyVisited = false;
    try {
      alreadyVisited = localStorage.getItem(VISITED_KEY) === '1';
    } catch {
      // Private browsing / disabled storage — just fall back to showing
      // the gate every time, same as before this feature existed.
    }

    if (alreadyVisited) {
      gate.style.display = 'none';
      // Deferred to astro:page-load rather than dispatched right here:
      // this script runs (and reaches this line) before BackgroundAudio's
      // own script further down the page has executed and attached its
      // 'site-entered' listener, so firing immediately would dispatch
      // into the void. astro:page-load fires only once every script on
      // the page has already run, first load included.
      document.addEventListener(
        'astro:page-load',
        () => {
          window.dispatchEvent(new Event('site-entered'));
        },
        { once: true }
      );
    } else {
      document.body.style.overflow = 'hidden';
      // Double rAF so the initial opacity:0 paints before we transition in.
      requestAnimationFrame(() => {
        requestAnimationFrame(() => gate.classList.add('is-visible'));
      });

      // Listens on the whole gate, not just the button, so clicking
      // anywhere on the overlay enters — not only a click on the text.
      gate.addEventListener(
        'click',
        () => {
          try {
            localStorage.setItem(VISITED_KEY, '1');
          } catch {}
          // This click is itself the gesture BackgroundAudio's document-
          // level click listener is waiting for — no extra wiring needed,
          // it just needs to actually reach `document`, which it does by
          // bubbling.
          gate.classList.remove('is-visible');
          gate.classList.add('is-hiding');
          document.body.style.overflow = '';
          window.dispatchEvent(new Event('site-entered'));
          setTimeout(() => {
            gate.style.display = 'none';
          }, FADE_MS);
        },
        { once: true }
      );
    }
  }
</script>
