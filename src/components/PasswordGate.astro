---
// Client-side only — for gating the site during testing, not real security.
// Change the password by editing SITE_PASSWORD below.
const SITE_PASSWORD = 'preview';
---

<div id="password-gate" class="password-gate" transition:persist="password-gate">
  <form id="password-form" class="password-form" autocomplete="off">
    <div class="password-label" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
        <rect x="5" y="11" width="14" height="10" rx="1.5"></rect>
        <path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
      </svg>
    </div>
    <div class="password-input-row">
      <input id="password-input" class="password-input" type="password" autocomplete="off" aria-label="Password" />
      <button type="submit" class="password-submit" aria-label="Submit">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </button>
    </div>
    <p id="password-error" class="password-error" hidden>Incorrect password.</p>
  </form>
</div>

<style>
  .password-gate {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: blur(1px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .password-gate.is-visible {
    opacity: 1;
  }

  .password-gate.is-hiding {
    opacity: 0;
    pointer-events: none;
  }

  .password-form {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .password-label {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-soft);
    margin: 0;
  }

  .password-input-row {
    position: relative;
    width: 200px;
  }

  .password-input {
    font-family: var(--font-body);
    font-size: 14.5px;
    font-weight: 400;
    padding: 6px 22px 6px 2px;
    border: none;
    border-bottom: 1px solid var(--ink);
    background: transparent;
    width: 100%;
    text-align: center;
  }

  .password-input:focus {
    outline: none;
    border-bottom-color: var(--accent);
  }

  .password-submit {
    position: absolute;
    right: 0;
    bottom: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }

  .password-submit:hover {
    color: var(--accent);
  }

  .password-error {
    font-family: var(--font-body);
    font-size: 14.5px;
    font-weight: 400;
    color: var(--accent);
    margin: 0;
  }
</style>

<script define:vars={{ SITE_PASSWORD }}>
  if (!window.__gateInit) {
    window.__gateInit = true;

    const UNLOCK_KEY = 'site-unlocked';
    const gate = document.getElementById('password-gate');
    const form = document.getElementById('password-form');
    const input = document.getElementById('password-input');
    const error = document.getElementById('password-error');

    const FADE_MS = 500;

    function unlock() {
      gate.classList.remove('is-visible');
      gate.classList.add('is-hiding');
      document.body.style.overflow = '';
      sessionStorage.setItem(UNLOCK_KEY, 'true');
      window.dispatchEvent(new Event('site-unlocked'));
      setTimeout(() => {
        gate.style.display = 'none';
      }, FADE_MS);
    }

    if (sessionStorage.getItem(UNLOCK_KEY) === 'true') {
      gate.style.display = 'none';
      window.dispatchEvent(new Event('site-unlocked'));
    } else {
      document.body.style.overflow = 'hidden';
      input.focus();
      // Double rAF so the initial opacity:0 paints before we transition in.
      requestAnimationFrame(() => {
        requestAnimationFrame(() => gate.classList.add('is-visible'));
      });
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (input.value === SITE_PASSWORD) {
          unlock();
        } else {
          error.hidden = false;
          input.value = '';
          input.focus();
        }
      });
    }
  }
</script>
