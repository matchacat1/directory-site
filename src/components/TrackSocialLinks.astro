---
import { socialLinks } from '../data/social-links';

interface Props {
  song: string;
}
const { song } = Astro.props;
const links = (socialLinks as Record<string, { spotify?: string; appleMusic?: string; instagram?: string }>)[song];
---

{links && (
  <>
  <div class="track-social-links">
    {links.spotify && (
      <a class="track-social-icon" href={links.spotify} aria-label="Spotify" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M7 10c3.5-1 7-1 10 1"></path>
          <path d="M7.5 13c3-.8 6-.8 8.5.6"></path>
          <path d="M8 16c2.3-.6 4.7-.6 6.7.5"></path>
        </svg>
      </a>
    )}
    {links.appleMusic && (
      <a class="track-social-icon" href={links.appleMusic} aria-label="Apple Music" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5"></rect>
          <path d="M10 15.5a2 2 0 1 1-1.2-1.83"></path>
          <path d="M8.8 13.67V8.2l6-1.2v5.5"></path>
          <path d="M14.8 12.5a2 2 0 1 1-1.2-1.83"></path>
        </svg>
      </a>
    )}
    {links.instagram && (
      <a class="track-social-icon" href={links.instagram} aria-label="Instagram" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5"></rect>
          <circle cx="12" cy="12" r="4"></circle>
          <circle cx="17.5" cy="6.5" r="0.75" fill="currentColor" stroke="none"></circle>
        </svg>
      </a>
    )}
  </div>
  </>
)}
