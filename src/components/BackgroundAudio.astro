---
import { audioTracks } from '../data/audio-tracks';

const DEFAULT_TRACK = audioTracks[0];
---

<div id="bg-audio-block" style="display:contents" transition:persist="bg-audio-block">
  <audio id="bg-audio-a" src={DEFAULT_TRACK.src} preload="auto"></audio>
  <audio id="bg-audio-b" src={DEFAULT_TRACK.src} preload="auto"></audio>

  <div id="volume-control" class="volume-control">
    <div class="volume-slider-wrap">
      <input
        id="volume-slider"
        class="volume-slider"
        type="range"
        min="0"
        max="1"
        step="0.01"
        value="0.35"
        aria-label="Volume"
      />
    </div>
    <div class="volume-icon-row">
      <button id="volume-icon" class="volume-icon" aria-label="Toggle background music" aria-pressed="true">
        <svg id="icon-on" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="4 9 4 15 8 15 13 20 13 4 8 9 4 9"></polygon>
          <path d="M16 8a5 5 0 0 1 0 8"></path>
          <path d="M18.5 5.5a9 9 0 0 1 0 13"></path>
        </svg>
        <svg id="icon-off" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none">
          <polygon points="4 9 4 15 8 15 13 20 13 4 8 9 4 9"></polygon>
          <line x1="16" y1="9" x2="22" y2="15"></line>
          <line x1="22" y1="9" x2="16" y2="15"></line>
        </svg>
      </button>
      <a id="now-playing" class="now-playing" href={`/music/${DEFAULT_TRACK.song}`}>Now playing: {DEFAULT_TRACK.nowPlaying}</a>
    </div>
  </div>

</div>

<style>
  .volume-control {
    position: fixed;
    left: 24px;
    bottom: 24px;
    display: flex;
    flex-direction: column;
    /* flex-start (not center) so the 28px-wide slider-wrap and the 28px-wide
       icon button — both left-aligned within the column — share a left
       edge. Centering here would center the slider over the full icon+text
       row instead of just the icon, once the "now playing" text widened
       that row. */
    align-items: flex-start;
    gap: 2px;
    z-index: 50;
  }

  .volume-icon-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .now-playing {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap;
    opacity: 0;
    /* Not clickable until it's actually shown (playback has begun) — see
       .is-visible below, which restores pointer-events once it is. */
    pointer-events: none;
  }

  .now-playing:hover {
    color: var(--accent);
  }

  .now-playing.is-visible {
    pointer-events: auto;
    animation: now-playing-blink 1.6s ease-in-out infinite;
  }

  @keyframes now-playing-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.3;
    }
  }

  .volume-icon {
    flex: 0 0 auto;
    width: 28px;
    height: 28px;
    border: none;
    background: transparent;
    color: var(--ink-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
  }

  .volume-icon:hover,
  .volume-icon:focus-visible {
    color: var(--accent);
  }

  .volume-slider-wrap {
    width: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    height: 0;
    transition: height 0.25s ease;
  }

  /* Hovering the icon reveals the slider — hovering the rest of the
     control (the "Now playing" link included) should not, since that's
     a separate, unrelated click target now. */
  .volume-control:has(.volume-icon:hover) .volume-slider-wrap,
  .volume-control:has(.volume-slider:hover) .volume-slider-wrap,
  .volume-control:has(.volume-slider:active) .volume-slider-wrap,
  .volume-control:focus-within .volume-slider-wrap,
  .volume-control.is-expanded .volume-slider-wrap {
    height: 64px;
  }

  /* Minimal vertical slider: thin line track, small black rectangle thumb */
  .volume-slider {
    width: 60px;
    height: 14px;
    margin: 0;
    -webkit-appearance: none;
    appearance: none;
    background: transparent;
    cursor: pointer;
    transform: rotate(-90deg);
    /* Without this, iOS can still claim the touch as its own native slider
       drag at the compositor level before our touchstart/touchmove
       handlers get a meaningful say — preventDefault() alone isn't a
       reliable guarantee. This hands touch handling on this element to
       JS entirely. */
    touch-action: none;
  }

  .volume-slider::-webkit-slider-runnable-track {
    height: 1px;
    background: var(--ink-faint);
  }

  .volume-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 4px;
    height: 14px;
    background: var(--ink);
    border-radius: 0;
    margin-top: -6.5px;
  }

  .volume-slider::-moz-range-track {
    height: 1px;
    background: var(--ink-faint);
    border: none;
  }

  .volume-slider::-moz-range-thumb {
    width: 4px;
    height: 14px;
    background: var(--ink);
    border: none;
    border-radius: 0;
  }

  .volume-slider:hover::-webkit-slider-thumb,
  .volume-slider:focus-visible::-webkit-slider-thumb {
    background: var(--accent);
  }

  .volume-slider:hover::-moz-range-thumb,
  .volume-slider:focus-visible::-moz-range-thumb {
    background: var(--accent);
  }
</style>

<script>
  import { audioTracks } from '../data/audio-tracks';

  if (!(window as any).__bgAudioInit) {
    (window as any).__bgAudioInit = true;

    const a = document.getElementById('bg-audio-a') as HTMLAudioElement;
    const b = document.getElementById('bg-audio-b') as HTMLAudioElement;
    const volumeControl = document.getElementById('volume-control') as HTMLElement;
    const iconBtn = document.getElementById('volume-icon') as HTMLButtonElement;
    const iconOn = document.getElementById('icon-on') as unknown as HTMLElement;
    const iconOff = document.getElementById('icon-off') as unknown as HTMLElement;
    const slider = document.getElementById('volume-slider') as HTMLInputElement;
    const nowPlaying = document.getElementById('now-playing') as HTMLAnchorElement | null;

    if (a && b && volumeControl && iconBtn && slider) {
      // The slider only expands on CSS :hover, which touch devices never
      // trigger reliably — without this it's an unreachable 0-height
      // control on mobile. Tapping anywhere in the control keeps it open;
      // tapping elsewhere on the page closes it again, mimicking hover-out.
      volumeControl.addEventListener('click', () => {
        volumeControl.classList.add('is-expanded');
      });
      document.addEventListener('click', (e) => {
        if (!volumeControl.contains(e.target as Node)) {
          volumeControl.classList.remove('is-expanded');
        }
      });

      // On mouse-driven devices, clicking/dragging the slider leaves it
      // focused, and :focus-within alone would then hold the slider open
      // indefinitely even after the cursor moves away. Dropping focus (and
      // the touch-only is-expanded latch) as soon as the pointer leaves the
      // control collapses it back down, matching hover-driven expectations.
      // Left untouched on touch devices, where there's no hover to leave.
      if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        volumeControl.addEventListener('mouseleave', () => {
          volumeControl.classList.remove('is-expanded');
          if (document.activeElement === slider) {
            slider.blur();
          }
        });
      }

      // The slider is visually rotated 90° via CSS. A native range input's
      // own touch handling doesn't reliably re-project touch coordinates
      // through that rotation on mobile browsers, so dragging it by touch
      // effectively does nothing. Driving the value from touch position
      // ourselves — measured against the wrapper, which is NOT rotated and
      // so is exactly what's on screen — sidesteps that while keeping the
      // native (working) mouse/keyboard behavior on desktop untouched.
      const sliderWrap = slider.closest('.volume-slider-wrap') as HTMLElement | null;
      let touchDragging = false;
      function setVolumeFromTouchY(clientY: number) {
        if (!sliderWrap) return;
        const rect = sliderWrap.getBoundingClientRect();
        if (rect.height < 2) return;
        const t = 1 - (clientY - rect.top) / rect.height;
        slider.value = Math.min(1, Math.max(0, t)).toFixed(2);
        slider.dispatchEvent(new Event('input', { bubbles: true }));
      }
      slider.addEventListener(
        'touchstart',
        (e) => {
          // Without this, the native (rotation-confused) touch-drag can
          // still partially engage alongside our own handling, and the two
          // fight over the input's value for the rest of the gesture —
          // which is exactly what an inconsistent/stuck-mute slider looks
          // like. Suppressing it from the first touch avoids that entirely.
          e.preventDefault();
          touchDragging = true;
          setVolumeFromTouchY(e.touches[0].clientY);
        },
        { passive: false }
      );
      slider.addEventListener(
        'touchmove',
        (e) => {
          if (!touchDragging) return;
          e.preventDefault();
          setVolumeFromTouchY(e.touches[0].clientY);
        },
        { passive: false }
      );
      slider.addEventListener('touchend', () => {
        touchDragging = false;
      });

      // Used for the natural gapless loop-restart (masking a track's own
      // seam, where slow and smooth reads as intentional).
      const FADE_SECONDS = 2.5;
      // Used when a visitor manually switches tracks — much shorter, since
      // here a fade is just softening a hard cut rather than hiding a loop
      // point, and it should feel responsive to click on.
      const SWITCH_FADE_SECONDS = 0.4;
      const FADE_IN_SECONDS = 2.5;
      const VOLUME_KEY = 'bg-audio-volume';

      let masterVolume = parseFloat(localStorage.getItem(VOLUME_KEY) ?? '0.35');
      if (Number.isNaN(masterVolume)) masterVolume = 0.35;
      // Mute is a per-session UI toggle only — never persisted, so a muted
      // test session can't silently block playback on a later visit.
      let muted = false;
      let duckFactor = 1;
      let duckDepth = 0;

      let active = a;
      let inactive = b;
      let crossfading = false;
      let activeMult = 0;
      let inactiveMult = 0;
      let started = false;
      let currentTrack = audioTracks[0];

      // The element whose playback position currentState() reports.
      // Usually the same object `active` points to — but the moment a
      // manual track switch begins, `currentTrack` updates immediately
      // while `active` still belongs to the outgoing track until its
      // ~2.5s crossfade finishes. Without tracking this separately, a
      // mixer row for the new track would briefly show the OLD track's
      // currentTime/duration (since currentState() would report the new
      // track's src alongside the old track's position), then jump once
      // the crossfade completed — the exact "wrong timeline, then snaps
      // to 0" delay this fixes.
      let currentEl = a;

      // Canceller for whichever crossfade (natural loop-restart or a
      // manual track switch) is currently running its volume ramp — lets
      // a new switch interrupt and immediately redirect an in-flight one
      // instead of being silently dropped while `crossfading` is true.
      // That drop was exactly what made rapid switching between songs
      // feel like it "sometimes doesn't change."
      let cancelCrossfadeAnim: (() => void) | null = null;

      // Set only by an explicit pause() call from page-level UI (e.g. the
      // etona mixer's pause button) — distinct from the tab-hidden
      // auto-pause below, which should resume on its own without this.
      let userPaused = false;

      function setNowPlayingDisplay(track: (typeof audioTracks)[number]) {
        if (!nowPlaying) return;
        nowPlaying.textContent = `Now playing: ${track.nowPlaying}`;
        nowPlaying.href = `/music/${track.song}`;
      }

      function currentState() {
        return {
          src: currentTrack.src,
          title: currentTrack.title,
          volume: masterVolume,
          muted,
          playing: started && !currentEl.paused,
          currentTime: currentEl.currentTime || 0,
          duration: currentEl.duration || 0,
        };
      }

      // Lets other page content (e.g. the etona mixer) read/drive the
      // sitewide player and stay in sync with it, without either side
      // needing to know about the other's DOM.
      function dispatchState() {
        window.dispatchEvent(new CustomEvent('bg-audio-state', { detail: currentState() }));
      }

      // iOS Safari silently ignores HTMLMediaElement.volume — physical
      // volume buttons are the only thing allowed to control loudness
      // there, so setting `.volume` in JS is a no-op on that platform. The
      // standard workaround is routing playback through the Web Audio API
      // and controlling a GainNode instead, which iOS does respect.
      const AudioContextCtor = window.AudioContext || (window as any).webkitAudioContext;
      let aGain: GainNode | null = null;
      let bGain: GainNode | null = null;
      let resumeAudioCtx = () => {};
      if (AudioContextCtor) {
        try {
          const audioCtx = new AudioContextCtor();
          aGain = audioCtx.createGain();
          bGain = audioCtx.createGain();
          audioCtx.createMediaElementSource(a).connect(aGain).connect(audioCtx.destination);
          audioCtx.createMediaElementSource(b).connect(bGain).connect(audioCtx.destination);
          resumeAudioCtx = () => {
            audioCtx.resume().catch(() => {});
          };
          document.addEventListener('visibilitychange', () => {
            if (!document.hidden) resumeAudioCtx();
          });
        } catch {
          aGain = null;
          bGain = null;
        }
      }

      function effectiveVolume(mult: number) {
        return muted ? 0 : masterVolume * duckFactor * mult;
      }

      function applyVolumes() {
        const activeVol = effectiveVolume(activeMult);
        const inactiveVol = effectiveVolume(inactiveMult);
        if (aGain && bGain) {
          (active === a ? aGain : bGain).gain.value = activeVol;
          (inactive === a ? aGain : bGain).gain.value = inactiveVol;
        } else {
          // Fallback for browsers without Web Audio API support.
          active.volume = activeVol;
          inactive.volume = inactiveVol;
        }
      }
      applyVolumes();

      // Drives a value from 0 to 1 over durationMs. Uses rAF for smooth
      // intermediate frames when the tab is visible, but the FINAL state is
      // always applied via setTimeout — rAF is throttled/paused in
      // backgrounded tabs, and without this fallback a crossfade started
      // right before the tab is backgrounded would never finish, leaving
      // the old track to hit its natural end and stop for good. Returns a
      // canceller that stops both without firing onTick(1)/onDone — used
      // to interrupt an in-flight crossfade when a newer one supersedes it.
      function animate(
        durationMs: number,
        onTick: (t: number) => void,
        onDone?: () => void,
        easing: (t: number) => number = (t) => t
      ) {
        const startTime = performance.now();
        let rafId: number | null = null;
        let timeoutId: ReturnType<typeof setTimeout> | null = null;

        function frame() {
          const raw = Math.min(1, (performance.now() - startTime) / durationMs);
          onTick(easing(raw));
          if (raw < 1) rafId = requestAnimationFrame(frame);
        }
        rafId = requestAnimationFrame(frame);

        timeoutId = setTimeout(() => {
          if (rafId !== null) cancelAnimationFrame(rafId);
          onTick(easing(1));
          onDone && onDone();
        }, durationMs);

        return () => {
          if (rafId !== null) cancelAnimationFrame(rafId);
          if (timeoutId !== null) clearTimeout(timeoutId);
        };
      }

      // Very fast initial velocity, decelerating smoothly to the target with
      // no overshoot. Used for the slider knob.
      function easeOutExpo(t: number) {
        return t >= 1 ? 1 : 1 - Math.pow(2, -10 * t);
      }

      // Zero velocity at both ends (gradual in, gradual out) — used for the
      // loop crossfade so the track's start and end blend in gently rather
      // than ramping at a constant, more noticeable rate.
      function smoothstep(t: number) {
        return t * t * (3 - 2 * t);
      }

      function startCrossfade() {
        if (crossfading) return;
        crossfading = true;
        inactive.currentTime = 0;
        inactive.play().catch(() => {});

        const activeStart = activeMult;
        cancelCrossfadeAnim = animate(
          FADE_SECONDS * 1000,
          (t) => {
            activeMult = activeStart * (1 - t);
            inactiveMult = t;
            applyVolumes();
          },
          () => {
            cancelCrossfadeAnim = null;
            active.pause();
            active.currentTime = 0;
            const oldActive = active;
            active = inactive;
            inactive = oldActive;
            // currentEl was never repointed during this loop (same track
            // throughout), so it's still the element that just paused —
            // sync it back to the element that's actually still playing.
            currentEl = active;
            activeMult = 1;
            inactiveMult = 0;
            applyVolumes();
            crossfading = false;
          },
          smoothstep
        );
      }

      // Switches the sitewide background track on demand — e.g. a page's
      // play button for a track that isn't the one currently active.
      // Reuses the same crossfade math as the natural gapless loop above,
      // just fading into a different src instead of the same one restarted.
      function crossfadeToTrack(track: (typeof audioTracks)[number]) {
        if (track.src === currentTrack.src) {
          ensurePlaying();
          return;
        }
        userPaused = false;
        currentTrack = track;
        setNowPlayingDisplay(track);
        nowPlaying?.classList.add('is-visible');

        if (!started) {
          a.src = track.src;
          b.src = track.src;
          currentEl = a;
          fadeInAndPlay();
          dispatchState();
          return;
        }

        // Interrupt whatever crossfade (a natural loop-restart, or a
        // previous manual switch) is currently in flight and redirect it
        // toward this newly-requested track, rather than dropping the
        // click — previously a click landing during another crossfade's
        // ~2.5s window did nothing at all.
        if (crossfading) {
          cancelCrossfadeAnim?.();
          cancelCrossfadeAnim = null;
        }
        crossfading = true;
        inactive.src = track.src;
        inactive.currentTime = 0;
        inactiveMult = 0;
        applyVolumes();
        // Report the new track's (fresh, near-0) position from here on,
        // not the outgoing track's — `inactive` is about to become
        // `active` once the fade completes, but the mixer should reflect
        // the switch immediately rather than waiting for that swap.
        currentEl = inactive;

        function beginRamp() {
          // Continues from wherever the outgoing track's volume currently
          // sits rather than assuming it starts at 1 — it may already be
          // partway faded down if this switch interrupted an earlier one.
          const activeStart = activeMult;
          cancelCrossfadeAnim = animate(
            SWITCH_FADE_SECONDS * 1000,
            (t) => {
              activeMult = activeStart * (1 - t);
              inactiveMult = t;
              applyVolumes();
            },
            () => {
              cancelCrossfadeAnim = null;
              active.pause();
              const oldActive = active;
              active = inactive;
              inactive = oldActive;
              // Keep the now-idle element's src matching the new active track
              // so the natural gapless-loop crossfade above still works for it.
              inactive.src = track.src;
              activeMult = 1;
              inactiveMult = 0;
              applyVolumes();
              crossfading = false;
              dispatchState();
            },
            smoothstep
          );
        }

        // A freshly-swapped src isn't preloaded like the initial track is,
        // so it can take a beat to actually start producing sound. Ramping
        // on a fixed timer regardless of that meant the fade curve was
        // already partway through by the time audio appeared — audible as
        // a pop-in rather than a smooth fade. Waiting for the play promise
        // to resolve (same pattern fadeInAndPlay uses) keeps the ramp
        // synced to when sound actually starts.
        const p = inactive.play();
        if (p) {
          p.then(beginRamp).catch(() => {
            crossfading = false;
          });
        } else {
          beginRamp();
        }
        dispatchState();
      }

      function onTimeUpdate(el: HTMLAudioElement) {
        return () => {
          if (el !== active || crossfading) return;
          if (!el.duration || !isFinite(el.duration)) return;
          if (el.duration - el.currentTime <= FADE_SECONDS) {
            startCrossfade();
          }
        };
      }
      a.addEventListener('timeupdate', onTimeUpdate(a));
      b.addEventListener('timeupdate', onTimeUpdate(b));

      // Safety net: if a track ever hits its natural end anyway (e.g. the
      // tab was asleep long enough that even the setTimeout fallback above
      // got delayed past the track boundary), hard-restart it rather than
      // leaving playback stopped.
      function onEnded(el: HTMLAudioElement) {
        return () => {
          if (el !== active) return;
          crossfading = false;
          el.currentTime = 0;
          activeMult = 1;
          inactiveMult = 0;
          applyVolumes();
          el.play().catch(() => {});
        };
      }
      a.addEventListener('ended', onEnded(a));
      b.addEventListener('ended', onEnded(b));

      function fadeInAndPlay() {
        if (started) return;
        started = true;
        activeMult = 0;
        applyVolumes();
        const p = active.play();

        function rampUp() {
          nowPlaying?.classList.add('is-visible');
          dispatchState();
          animate(FADE_IN_SECONDS * 1000, (t) => {
            activeMult = t;
            applyVolumes();
          });
        }

        if (p) {
          p.then(rampUp).catch(() => {
            started = false;
            // Browsers block audible autoplay until the visitor has made a
            // "sticky activation" gesture on the page — no code workaround
            // for that, so the best we can do is start on the very first
            // one of these, whichever comes first, instead of narrowing it
            // down to just a click.
            const resumeEvents: [string, AddEventListenerOptions][] = [
              ['click', {}],
              ['keydown', {}],
              ['touchstart', { passive: true }],
              ['pointerdown', {}],
              ['scroll', { passive: true }],
            ];
            const resume = () => {
              started = true;
              active.play().then(rampUp).catch(() => {});
              resumeEvents.forEach(([type]) => document.removeEventListener(type, resume));
            };
            resumeEvents.forEach(([type, options]) =>
              document.addEventListener(type, resume, { ...options, once: true })
            );
          });
        } else {
          rampUp();
        }
      }

      function ensurePlaying() {
        userPaused = false;
        if (!started) {
          fadeInAndPlay();
        } else {
          if (active.paused) {
            active.play().catch(() => {});
          }
          nowPlaying?.classList.add('is-visible');
        }
        dispatchState();
      }

      function pauseAudio() {
        userPaused = true;
        a.pause();
        b.pause();
        nowPlaying?.classList.remove('is-visible');
        dispatchState();
      }

      // Playback only actually begins once the visitor clicks past
      // EnterGate — that click is a real user gesture, so by waiting for
      // it there's no need for the muted-autoplay-then-unmute workaround
      // browsers otherwise require: .play() just succeeds normally here.
      window.addEventListener(
        'site-entered',
        () => {
          resumeAudioCtx();
          fadeInAndPlay();
        },
        { once: true }
      );

      // Pause while the tab is hidden/backgrounded rather than letting it
      // keep playing behind the scenes, and pick back up when it's visible
      // again — unless a page-level pause button explicitly paused it, in
      // which case coming back to the tab shouldn't un-pause it on its own.
      // Both elements are resumed — whichever is currently inactive is
      // already sitting at volume 0 from the normal crossfade bookkeeping,
      // so resuming it is silent and just keeps it ready for the next swap.
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          a.pause();
          b.pause();
        } else if (started && !userPaused) {
          a.play().catch(() => {});
          b.play().catch(() => {});
        }
      });

      // --- ducking: fade out when other audio/video on the page plays ---
      let duckStart = 1;
      function fadeDuck(target: number, ms = 600) {
        duckStart = duckFactor;
        animate(ms, (t) => {
          duckFactor = duckStart + (target - duckStart) * t;
          applyVolumes();
        });
      }

      document.addEventListener(
        'play',
        (e) => {
          const t = e.target;
          // A muted element (the renders' silent looping videos, e.g.) has
          // nothing to compete with the background music for — ducking for
          // it just needlessly quiets the music every time one starts.
          if (t === a || t === b || !(t instanceof HTMLMediaElement) || t.muted) return;
          duckDepth++;
          fadeDuck(0.15);
        },
        true
      );

      function maybeUnduck(e: Event) {
        const t = e.target;
        if (t === a || t === b || !(t instanceof HTMLMediaElement) || t.muted) return;
        duckDepth = Math.max(0, duckDepth - 1);
        if (duckDepth === 0) fadeDuck(1);
      }
      document.addEventListener('pause', maybeUnduck, true);
      document.addEventListener('ended', maybeUnduck, true);

      // --- volume control UI ---
      function updateIcon() {
        const isMuted = muted || masterVolume === 0;
        iconOn.style.display = isMuted ? 'none' : 'block';
        iconOff.style.display = isMuted ? 'block' : 'none';
        iconBtn.setAttribute('aria-pressed', String(!isMuted));
      }

      function animateSliderTo(target: number, ms = 320) {
        const sliderAnimStart = parseFloat(slider.value);
        animate(
          ms,
          (t) => {
            const v = sliderAnimStart + (target - sliderAnimStart) * t;
            slider.value = String(Math.min(1, Math.max(0, v)));
          },
          undefined,
          easeOutExpo
        );
      }

      slider.value = String(muted ? 0 : masterVolume);
      updateIcon();

      function toggleMute() {
        muted = !muted;
        applyVolumes();
        updateIcon();
        animateSliderTo(muted ? 0 : masterVolume);
        ensurePlaying();
        dispatchState();
      }

      iconBtn.addEventListener('click', toggleMute);

      window.addEventListener('keydown', (e) => {
        if (e.key.toLowerCase() !== 'm' || e.repeat || e.metaKey || e.ctrlKey || e.altKey) return;
        const target = e.target as HTMLElement | null;
        if (target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable)) return;
        toggleMute();
      });

      function setMasterVolume(v: number) {
        masterVolume = Math.min(1, Math.max(0, v));
        muted = masterVolume === 0;
        localStorage.setItem(VOLUME_KEY, String(masterVolume));
        slider.value = String(masterVolume);
        applyVolumes();
        updateIcon();
        ensurePlaying();
        dispatchState();
      }

      slider.addEventListener('input', () => setMasterVolume(parseFloat(slider.value)));

      // Small API so page-level content (e.g. the etona mixer's play/pause
      // buttons and seek bars) can read and drive the sitewide player
      // without either side needing direct references to the other's DOM.
      (window as any).__bgAudio = {
        getState: () => currentState(),
        switchTrack: (track: (typeof audioTracks)[number]) => crossfadeToTrack(track),
        setVolume: (v: number) => setMasterVolume(v),
        play: () => ensurePlaying(),
        pause: () => pauseAudio(),
        seek: (t: number) => {
          const d = active.duration;
          active.currentTime = Math.max(0, isFinite(d) ? Math.min(t, d) : t);
          dispatchState();
        },
      };
      dispatchState();
    }
  }
</script>
